# 数据库配置
DATABASE_URL="postgresql://username:password@localhost:15432/database_name"

# JWT配置
AUTH_ENABLED=true
AI_AUTH_REQUIRED=true
TRPC_AUTH_REQUIRED=true
JWT_SECRET="your-super-secret-jwt-key-here"

# 邮件配置
RESEND_API_KEY="your-resend-api-key-here"
EMAIL_FROM="noreply@sendmail.tobenot.top"
EMAIL_FROM_NAME="YourApp"

# 服务器配置
PORT=3000
HOST=localhost
NODE_ENV=development

# 前端配置
FRONTEND_LOCAL_URL="http://localhost:5173"
FRONTEND_PRODUCTION_URL="https://tobenot.top/Basic-Web-Game/#/demo-with-backend"

# 后端配置
BACKEND_LOCAL_URL="http://localhost:3000"
BACKEND_PRODUCTION_URL="https://bwb.tobenot.top"

# CORS配置
CORS_ENABLED=true
CORS_MAX_AGE=86400
CORS_ADDITIONAL_ORIGINS="https://your-additional-domain.com,https://another-domain.com"

OPENAI_API_KEY="xxxx"
OPENAI_BASE_URL="https://api.openai.com"

# 匿名会话 cookie 的 SameSite(跨站 iframe 游戏如 itch.io 需 None;同域部署用 Lax 更稳)
# 默认: 生产 None,开发 Lax
ANON_COOKIE_SAMESITE="None"

# 套件服务配置
# 缺省 game_id(请求未带时回退);游戏条目见 src/config/games.ts
DEFAULT_GAME_ID="wenming"
# GAMES_CONFIG='{"newgame":{"dailyFreeTokens":30000}}'   # env 覆盖游戏配置
# 全局每日预算硬顶(所有游戏合计,token 数)
AI_DAILY_BUDGET_TOKENS=500000

# Cloudflare Turnstile 人机验证(首次 AI 对话时触发)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=""

FEATURE_PASSWORD_ENABLED=true
FEATURE_PASSWORDS="admin-key:llm-all,admin-panel;marketing-key:llm-gemini;dev-key:llm-deepseek"